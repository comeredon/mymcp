# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ==========================================
# Use this file for local development only
# Copy to .env.local and fill in actual values
#
# For Azure deployment, use .azure/mcp/.env instead
# ==========================================

# Azure AI Search Configuration
SEARCH_ENDPOINT=https://your-search-service.search.windows.net/
SEARCH_KEY=your-actual-search-admin-key
SEARCH_INDEX=pdf-index

# Azure Storage Configuration
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=...
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_CONTAINER_NAME=pdfs

# Azure AI Foundry Configuration
AI_FOUNDRY_ENDPOINT=https://your-ai-foundry-account.cognitiveservices.azure.com/
AI_FOUNDRY_KEY=your-ai-foundry-key
AI_FOUNDRY_EMBEDDING_DEPLOYMENT=embeddings
AI_FOUNDRY_CHAT_DEPLOYMENT=chat

# Server API Key (for local development only)
SERVER_API_KEY=your-api-key

# Server Port (for local development)
PORT=8080

