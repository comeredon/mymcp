# MCP Server Configuration (for local development only)
# These values are set after deployment - see deployment output for actual values

# Azure AI Search Configuration
# After deployment, you'll get these from the deployment output
SEARCH_ENDPOINT=https://your-search-service.search.windows.net/
SEARCH_KEY=your-actual-search-admin-key
SEARCH_INDEX=pdf-index

# Server API Key
# Generated during deployment - update with your actual key
SERVER_API_KEY=your-api-key

# Server Port (for local development)
PORT=8080

# MCP Server URL (for testing and client configuration)
# After deployment, update this with your actual Container App URL
MCP_SERVER_URL=https://your-container-app-url.azurecontainerapps.io/api/tools
