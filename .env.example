# Azure AI Search Configuration
# Get these values from your Azure AI Search service in the Azure Portal
SEARCH_ENDPOINT=https://your-search-service.search.windows.net/
SEARCH_KEY=your-actual-search-admin-key
SEARCH_INDEX=your-pdf-index-name

# Server Configuration  
# Generate a secure random API key for authentication
SERVER_API_KEY=your-secure-api-key
PORT=8080

# Azure Deployment Settings (optional)
# Customize these if you want to use different resource group or location
AZURE_RESOURCE_GROUP=mcpserver
AZURE_LOCATION=swedencentral

# MCP Server URL (for testing and client configuration)
# After deployment, update this with your actual Container App URL
MCP_SERVER_URL=https://your-container-app-url.azurecontainerapps.io/api/tools
