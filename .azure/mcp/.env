# ==========================================
# AZURE DEVELOPER CLI (AZD) CONFIGURATION
# ==========================================
# This file configures the Azure deployment
# Used by: azd up, azd deploy, azd provision
#
# For local development, use .env.local instead
# ==========================================

# Core Settings - REQUIRED
AZURE_ENV_NAME=mcp
AZURE_LOCATION=swedencentral

# Optional: Customize deployment
# SEARCH_INDEX_NAME=pdf-index
# CONTAINER_APP_CPU=0.25
# CONTAINER_APP_MEMORY=0.5Gi

# API Management - REQUIRED for secure access
# Update these with your actual information before deployment
# APIM_PUBLISHER_EMAIL=admin@contoso.com
# APIM_PUBLISHER_NAME=Contoso

# Advanced: Virtual Network (disabled by default)
# DEPLOY_VNET=false
